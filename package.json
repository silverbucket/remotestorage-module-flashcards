{
    "name": "remotestorage-module-flashcards",
    "version": "2.0.1",
    "description": "remoteStorage.js data module for flashcards with spaced-repetition review state",
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        }
    },
    "files": [
        "dist",
        "src",
        "!src/**/*.test.ts"
    ],
    "scripts": {
        "build": "rm -rf dist && tsc -p tsconfig.build.json",
        "typecheck": "tsc --noEmit",
        "test": "bun test",
        "lint": "biome check .",
        "prepublishOnly": "bun run typecheck && bun test && bun run build"
    },
    "author": "Nick Jennings",
    "license": "MIT",
    "peerDependencies": {
        "remotestoragejs": "^2.0.0-beta.10"
    },
    "devDependencies": {
        "@biomejs/biome": "2.6.8",
        "@types/bun": "^1.4.4",
        "remotestoragejs": "2.0.0-beta.10",
        "typescript": "^6"
    },
    "keywords": [
        "remotestorage",
        "remotestorage-module",
        "flashcards",
        "fsrs"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/silverbucket/remotestorage-module-flashcards.git"
    }
}
